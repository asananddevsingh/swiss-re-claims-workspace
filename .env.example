# Postgres connection string. Built against Neon — use the pooled endpoint
# (host contains -pooler), since serverless functions open a connection per
# cold start and would otherwise exhaust the direct endpoint's limit.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Any random string. Signs the session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me"
